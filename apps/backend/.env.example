NODE_ENV=development
PORT=4000
DB_URL="postgresql://user:password@localhost:5432/skvoid"
REDIS_URL="redis://localhost:6379"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MP_PUBLIC_KEY=your-public-key
MP_ACCESS_TOKEN=your-access-token
MP_CLIENT_ID=your-client-id
MP_CLIENT_SECRET=your-client-secret
MP_WEBHOOK_SECRET=your-webhook-secret
MP_WEBHOOK_URL=https://your-host/webhooks/mp
FRONT_SUCCESS_URL=https://skvoid.dev/success
FRONT_FAILURE_URL=https://skvoid.dev/failure
FRONT_PENDING_URL=https://skvoid.dev/pending
PLATFORM_COMMISSION_RATE=0.15
MIN_WITHDRAWAL_AMOUNT=50
PAYOUT_SCHEDULE=0 9 * * 1
EMAIL_PROVIDER_DSN=smtp://user:pass@mail.com
SMS_PROVIDER_API_KEY=your-sms-key
SENTRY_DSN=https://example.ingest.sentry.io/123
TOTP_ISSUER=SkVoid

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum UserRole {
  AdminPrincipal
  Admin
  Seller
  Buyer
}

enum UserStatus {
  active
  suspended
  banned
}

enum OrderStatus {
  PENDING
  PAID_PENDING_VERIFICATION
  COMPLETED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KycStatus {
  none
  pending
  approved
  rejected
}

enum AnnouncementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(Buyer)
  status         UserStatus   @default(active)
  totpSecret     String?
  totpEnabled    Boolean      @default(false)
  kycStatus      KycStatus    @default(none)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sellerProfile  Seller?
  wallet         UserWallet?
  refreshToken   RefreshToken?
  subscriptions  UserSubscription[]
  announcements  Announcement[] @relation("UserAnnouncements")
  orders         Order[]       @relation("BuyerOrders")
  sales          Order[]       @relation("SellerOrders")
  tickets        Ticket[]      @relation("TicketCreator")
  assignedTicket Ticket[]      @relation("TicketAssignee")
  chats          Chat[]        @relation("ChatParticipant")
  messages       Message[]
  auditLogs      AuditLog[]    @relation("AuditActor")
}

model RefreshToken {
  userId    String  @id
  token     String
  expiresAt DateTime
  user      User    @relation(fields: [userId], references: [id])
}

model UserWallet {
  id        String               @id @default(uuid())
  userId    String               @unique
  balance   Decimal              @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id])
  txns      WalletTransaction[]
}

model WalletTransaction {
  id               String          @id @default(uuid())
  walletId         String
  type             TransactionType
  amount           Decimal
  balanceAfter     Decimal
  reference        String?
  idempotencyKey   String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  wallet           UserWallet      @relation(fields: [walletId], references: [id])
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  name              String
  description       String
  price             Decimal
  maxListings       Int
  commission        Decimal
  withdrawalSpeed   String
  perks             String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subscriptions     UserSubscription[]
}

model UserSubscription {
  id             String            @id @default(uuid())
  userId         String
  planId         String
  status         String            @default("active")
  startsAt       DateTime          @default(now())
  endsAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id])
  plan           SubscriptionPlan  @relation(fields: [planId], references: [id])
}

model Seller {
  id                String   @id @default(uuid())
  userId            String   @unique
  onboardedAt       DateTime @default(now())
  bio               String?
  rating            Decimal? @default(0)
  status            String   @default("active")
  activeListings    Int      @default(0)
  kycRequired       Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id])
  announcements     Announcement[]
  orders            Order[]
}

model Announcement {
  id             String              @id @default(uuid())
  sellerId       String
  title          String
  description    String
  price          Decimal
  platform       String
  tags           String[]
  condition      String
  status         AnnouncementStatus @default(DRAFT)
  badges         String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  seller         Seller             @relation(fields: [sellerId], references: [id])
  images         AnnouncementImage[]
  orders         Order[]
}

model AnnouncementImage {
  id              String        @id @default(uuid())
  announcementId  String
  url             String
  position        Int
  createdAt       DateTime      @default(now())
  announcement    Announcement  @relation(fields: [announcementId], references: [id])
}

model Order {
  id             String       @id @default(uuid())
  buyerId        String
  sellerId       String
  announcementId String
  amount         Decimal
  commission     Decimal
  status         OrderStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  buyer          User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller         User         @relation("SellerOrders", fields: [sellerId], references: [id])
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  payment        Payment?
  tickets        Ticket[]
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String?
  walletId        String?
  provider        String
  providerId      String
  status          String
  amount          Decimal
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order?   @relation(fields: [orderId], references: [id])
  wallet          UserWallet? @relation(fields: [walletId], references: [id])
  refunds         Refund[]
}

model Refund {
  id         String   @id @default(uuid())
  paymentId  String
  amount     Decimal
  reason     String
  status     String
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id])
}

model Payout {
  id             String   @id @default(uuid())
  sellerId       String
  amount         Decimal
  fee            Decimal
  status         String   @default("pending")
  scheduledFor   DateTime?
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  seller         Seller   @relation(fields: [sellerId], references: [id])
}

model Ticket {
  id             String         @id @default(uuid())
  orderId        String?
  creatorId      String
  assigneeId     String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  subject        String
  description    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order?         @relation(fields: [orderId], references: [id])
  creator        User           @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages       TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Chat {
  id           String    @id @default(uuid())
  buyerId      String
  sellerId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
  buyer        User      @relation("ChatParticipant", fields: [buyerId], references: [id])
  seller       User      @relation("ChatParticipant", fields: [sellerId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  authorId  String
  body      String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  UserRole?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
}

model BanEntry {
  id        String   @id @default(uuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
}

model RiskEvent {
  id        String   @id @default(uuid())
  userId    String?
  score     Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
